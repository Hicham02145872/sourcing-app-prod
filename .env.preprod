# =============================================================================
# .env.preprod — Pre-Production Environment (SmartSourcing)
# =============================================================================
# Usage: docker compose -f docker-compose.preprod.yml --env-file .env.preprod up -d
# =============================================================================

APP_NAME=SmartSourcing
APP_ENV=preprod
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://preprod.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry (optionnel — laisser vide pour désactiver)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2

# ── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=s_app_preprod
DB_USERNAME=sourcing
DB_PASSWORD=CHANGE_ME_PREPROD_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_PREPROD_ROOT_PASSWORD

# ── Sessions & Cache ────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# ── Queue ───────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_EMAIL@gmail.com
MAIL_PASSWORD=YOUR_APP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@preprod.your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Broadcast ───────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ── Filesystem ──────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Firebase (Push Notifications) ───────────────────────────────────────────
FIREBASE_CREDENTIALS=storage/app/firebase_credentials.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=

# ── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_URL=

# ── Docker Ports (hôtes) ───────────────────────────────────────────────────
APP_PORT=80
DB_PORT=3307
REDIS_PORT=6380
TRACKING_PORT=5001
