# =============================================================================
# Dockerfile — E2E Testing (SmartSourcing)
# Multi-stage: Frontend → Backend → Final image with Playwright
# =============================================================================

# Stage 1: Frontend Asset Builder
FROM node:18-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: Backend Dependency Builder
FROM composer:2.5 AS backend
WORKDIR /app
COPY --from=frontend /app .
RUN composer install --no-dev --optimize-autoloader --no-scripts

# Stage 3: Final Testing Image
FROM php:8.2-fpm
WORKDIR /var/www/html

# Install system dependencies, PHP extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    libzip-dev \
    libicu-dev \
    supervisor \
    cron \
    gnupg \
    ca-certificates \
    apt-transport-https \
    wget \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libxshmfence1 \
    fonts-liberation \
    xdg-utils \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd dom fileinfo zip intl \
    && pecl install redis \
    && docker-php-ext-enable redis opcache \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 (for Vite dev server + npm 12+)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs

# Copy application code and compiled assets
COPY --from=backend /app .

# Install Playwright + Chromium
RUN npx -y playwright install chromium --with-deps || true

# Copy test files into the image
COPY tests/e2e /var/www/html/tests/e2e
COPY playwright.config.ts /var/www/html/playwright.config.ts

# Set correct permissions
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 9000
CMD ["php-fpm"]
